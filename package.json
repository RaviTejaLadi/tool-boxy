{
  "name": "tool-boxy",
  "description": "Finding the right utility shouldn't slow down your workflow. ToolBoxy is a lightweight, all-in-one web toolkit designed for developers, designers, and creators who need fast, frictionless answers without opening a dozen browser tabs. 🚀",
  "author": "Tool Boxy",
  "license": "MIT",
  "homepage": "https://tool-boxy.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tool-boxy/tool-boxy.git"
  },
  "keywords": [
    "tool",
    "boxy",
    "toolbox"
  ],
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --ignore-path .prettierignore --write \"**/*.{js,ts,tsx,json,md,mdx}\"",
    "pre-commit": "npm run format && npm run lint && npm run build"
  },
  "dependencies": {
